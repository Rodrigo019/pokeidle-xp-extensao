{
  "manifest_version": 3,
  "name": "PokeIdle - Tempo para o nível",
  "version": "1.0.0",
  "description": "Mostra quanto tempo falta para o pokemon e o treinador chegarem a um nível no PokeIdle. Só lê a página.",
  "homepage_url": "https://github.com/Rodrigo019/pokeidle-xp-extensao",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://pokeidle.io/*", "https://www.pokeidle.io/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
